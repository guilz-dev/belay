{
  "version": 1,
  "groups": [
    {
      "id": "nested",
      "label": "Shell chains and nesting",
      "cases": [
        {
          "id": "nested.pipe.readonly",
          "command": "git status | head",
          "tags": ["nested", "pipe", "git"],
          "expectations": {
            "default": { "verdict": "allow" },
            "structural": { "verdict": "allow" }
          }
        },
        {
          "id": "nested.and.push",
          "command": "git status && git push origin main",
          "tags": ["nested", "chain", "git", "must-ask"],
          "expectations": {
            "default": { "verdict": "deny_pending_approval" },
            "structural": { "verdict": "deny_pending_approval" }
          }
        },
        {
          "id": "nested.pipe.bash",
          "command": "echo hi | bash",
          "tags": ["nested", "pipe", "must-ask"],
          "expectations": {
            "default": { "verdict": "deny_pending_approval" },
            "structural": { "verdict": "deny_pending_approval" }
          }
        },
        {
          "id": "nested.subshell.curl",
          "command": "(curl https://example.com)",
          "tags": ["nested", "subshell", "network", "explore"]
        },
        {
          "id": "nested.bash_c.push",
          "command": "bash -c \"git push origin main\"",
          "tags": ["nested", "wrapper", "must-ask"],
          "expectations": {
            "default": { "verdict": "deny_pending_approval" },
            "structural": { "verdict": "deny_pending_approval" }
          }
        },
        {
          "id": "nested.substitution.status",
          "command": "echo $(git status)",
          "tags": ["nested", "substitution", "git"],
          "expectations": {
            "structural": { "verdict": "allow" }
          },
          "notes": "structural-suite regression"
        },
        {
          "id": "nested.cd.tmp.rm",
          "command": "cd /tmp && rm -rf foo",
          "tags": ["nested", "chain", "must-ask"],
          "expectations": {
            "structural": { "verdict": "deny_pending_approval" }
          }
        },
        {
          "id": "nested.multiline",
          "command": "ls\ncurl https://example.com",
          "tags": ["nested", "multiline", "network"],
          "expectations": {
            "default": { "verdict": "deny_pending_approval" },
            "structural": { "verdict": "deny_pending_approval" }
          }
        },
        {
          "id": "nested.xargs.curl",
          "command": "echo payload | xargs -I{} curl https://example.com/{}",
          "tags": ["nested", "pipe", "must-ask"],
          "expectations": {
            "default": { "verdict": "deny_pending_approval" },
            "structural": { "verdict": "deny_pending_approval" }
          }
        },
        {
          "id": "nested.or.readonly",
          "command": "git status || echo failed",
          "tags": ["nested", "chain", "git", "explore"]
        }
      ]
    },
    {
      "id": "docker",
      "label": "Docker commands",
      "cases": [
        {
          "id": "docker.info",
          "command": "docker info",
          "tags": ["docker", "read"],
          "expectations": {
            "default": { "verdict": "allow" },
            "structural": { "verdict": "allow" }
          }
        },
        {
          "id": "docker.run",
          "command": "docker run node:22 node -v",
          "tags": ["docker", "must-ask"],
          "expectations": {
            "default": { "verdict": "deny_pending_approval" },
            "structural": { "verdict": "deny_pending_approval" }
          }
        },
        {
          "id": "docker.push",
          "command": "docker push myimage:latest",
          "tags": ["docker", "must-ask"],
          "expectations": {
            "structural": { "verdict": "deny_pending_approval", "reason": "external_effect" }
          }
        },
        {
          "id": "docker.build.push",
          "command": "docker build --push -t r/app .",
          "tags": ["docker", "must-ask"],
          "expectations": {
            "structural": { "verdict": "deny_pending_approval" }
          }
        },
        {
          "id": "docker.buildx.push",
          "command": "docker buildx build --push -t r/app .",
          "tags": ["docker", "must-ask"],
          "expectations": {
            "structural": { "verdict": "deny_pending_approval" }
          }
        },
        {
          "id": "docker.build.local",
          "command": "docker build -t myapp .",
          "tags": ["docker", "explore"],
          "notes": "structural: no tier0_external floor"
        },
        {
          "id": "docker.buildx.local",
          "command": "docker buildx build -t myapp .",
          "tags": ["docker", "explore"]
        },
        {
          "id": "docker.compose.up",
          "command": "docker compose up -d",
          "tags": ["docker", "explore"]
        }
      ]
    },
    {
      "id": "python",
      "label": "Python direct execution",
      "cases": [
        {
          "id": "python.version",
          "command": "python3 --version",
          "tags": ["python", "read", "explore"]
        },
        {
          "id": "python.c.print",
          "command": "python3 -c \"print(1)\"",
          "tags": ["python", "explore"]
        },
        {
          "id": "python.c.read",
          "command": "python3 -c \"open('package.json').read()\"",
          "tags": ["python", "explore"]
        },
        {
          "id": "python.c.write",
          "command": "python3 -c \"open('out.txt','w').write('x')\"",
          "tags": ["python", "explore"]
        },
        {
          "id": "python.c.network",
          "command": "python3 -c \"import urllib.request; urllib.request.urlopen('https://example.com')\"",
          "tags": ["python", "network", "explore"]
        },
        {
          "id": "python.script",
          "command": "python3 scripts/sync-version.mjs",
          "tags": ["python", "explore"]
        },
        {
          "id": "python.m.pip",
          "command": "python3 -m pip install requests",
          "tags": ["python", "must-ask", "explore"]
        }
      ]
    },
    {
